# Internal gateway/API auth key shared between hermes-agent and hermes-webui.
# Generate one:  openssl rand -hex 32   (then copy to .env)
API_SERVER_KEY=ein-langes-zufaelliges-geheimnis

# Optional: enable API server (true/false)
API_SERVER_ENABLED=true
# Port for the API server (default 8642)
API_SERVER_PORT=8642

# OpenAI API key (required for both agent and webui)
OPENAI_API_KEY=deine-openai-api-key
# Optional base URL for OpenAI (defaults to 9router)
OPENAI_BASE_URL=https://9router.arbeitermili.eu/v1
# Hermes custom_providers key env (exported from OPENAI_API_KEY by docker-compose)
# Used by custom_providers entries with key_env: CUSTOM_9ROUTER_ARBEITERMILI_EU_API_KEY
CUSTOM_9ROUTER_ARBEITERMILI_EU_API_KEY=deine-openai-api-key

# User and group IDs for file permissions (default 1000)
WANTED_UID=1000
WANTED_GID=1000

# Hermes home directory (default /home/hermes/.hermes)
HERMES_HOME=/home/hermes/.hermes

# WebUI configuration
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_PASSWORD=dein-webui-passwort
HERMES_WEBUI_STATE_DIR=/home/hermes/.hermes/webui
HERMES_WEBUI_DEFAULT_WORKSPACE=/workspace
HERMES_WEBUI_AGENT_DIR=/home/hermes/.hermes/hermes-agent
HERMES_WEBUI_AUTO_INSTALL=1
HERMES_WEBUI_DEFAULT_MODEL=all_coding

# Misc settings
TERMINAL_ENV=local
HERMES_EXEC_ASK=1
